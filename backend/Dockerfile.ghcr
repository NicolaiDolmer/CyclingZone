# Backend-image til GHCR (#7034). Bygges af .github/workflows/backend-image.yml.
#
# Filen hedder IKKE "Dockerfile": Railway bruger automatisk en Dockerfile i
# servicens rodmappe (/backend), og så ville de nuvaerende Railway-builds skifte
# builder, foer ejeren har sagt go til at skifte kilde. Se
# docs/runbooks/RAILWAY_IMAGE_DEPLOY.md.
#
# Node 24.x som engines i backend/package.json (#7020 pinner 24.22.1). Basen er
# pinnet paa digest, saa samme commit altid giver samme image.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205

# Railway saetter kun RAILWAY_GIT_COMMIT_SHA ved deploy fra GitHub. Ved
# image-kilde ville Sentry ellers miste release (lib/sentry.js releaseName).
ARG GIT_SHA
ENV SENTRY_RELEASE=${GIT_SHA}
ENV NODE_ENV=production
WORKDIR /app

# Afhaengigheder foerst, saa laget caches, naar kun koden aendres. Ingen
# devDependencies importeres ved runtime (tjekket 22/10).
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY --chown=node:node . .

USER node
# PORT saettes af Railway; server.js falder tilbage til 3001.
EXPOSE 3001
# Samme start som railway.json deploy.startCommand. node er PID 1 og fanger
# selv SIGTERM (gracefulShutdown i server.js).
CMD ["node", "--import", "./instrument.mjs", "server.js"]
