{
  "name": "cycling-zone-manager-frontend",
  "version": "4.34.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build": "node scripts/generate-indexnow-key.ts && vite build && node ../scripts/carry-forward-assets.mjs && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node ../scripts/upload-release-assets.mjs",
    "preview": "vite preview",
    "preview:e2e": "node scripts/e2e-static-server.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint . && node scripts/check-fetch-wiring.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "tsc -p tsconfig.json",
    "types:gen": "supabase gen types typescript --project-id ghwvkxzhsbbltzfnuhhz > src/types/database.types.ts && node ../scripts/strip-backup-tables-from-types.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@microsoft/clarity": "^1.0.2",
    "@sentry/react": "^11.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.11.1",
    "@vercel/og": "1.0.1",
    "flag-icons": "^7.5.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-http-backend": "^4.0.10",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.4",
    "posthog-js-lite": "^4.13.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-is": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sentry/vite-plugin": "^11.11.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sirv": "^3.0.2",
    "tailwindcss": "4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch@^10.0.0": "^11.0.3"
  }
}
