{
  "name": "cycling-zone-manager-frontend",
  "version": "4.34.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:preview": "node scripts/dev-preview.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "preview:e2e": "node scripts/e2e-static-server.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "tsc -p tsconfig.json",
    "types:gen": "supabase gen types typescript --project-id ghwvkxzhsbbltzfnuhhz > src/types/database.types.ts && node ../scripts/strip-backup-tables-from-types.mjs"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@microsoft/clarity": "^1.0.2",
    "@sentry/react": "^10.72.0",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/analytics": "^2.0.1",
    "flag-icons": "^7.5.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-is": "^19.2.8",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "sirv": "^3.0.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
