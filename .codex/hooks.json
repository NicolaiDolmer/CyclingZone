{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 .claude/hooks/block-dangerous-secret-commands.sh ; exit $LASTEXITCODE",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/block-branch-switch-in-main-checkout.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/setup-worktree-if-needed.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/lint-gh-issue.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/check-ci-before-push.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/check-preflight-before-push.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/block-blocking-shell-commands.sh ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/check-now-md-edit.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/block-archived-edit.sh ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/check-now-md-edit.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/block-archived-edit.sh ; exit $LASTEXITCODE"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/check-now-md-edit.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/block-archived-edit.sh ; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 .claude/hooks/sanitize-secrets.sh ; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 .claude/hooks/sanitize-secrets.sh ; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 .claude/hooks/sanitize-secrets.sh ; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 .claude/hooks/sanitize-secrets.sh ; exit $LASTEXITCODE",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/session-prefetch-issue.sh ; exit $LASTEXITCODE",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/ensure-scheduled-tasks.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/setup-worktree-if-needed.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/set-active-sessions.sh ; exit $LASTEXITCODE"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/check-now-md.sh ; exit $LASTEXITCODE"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/hooks/run-codex-hook.ps1 scripts/hooks/clear-active-sessions.sh ; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
